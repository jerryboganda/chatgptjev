{
  "name": "chatgpt-jev-launcher",
  "version": "5.0.14",
  "private": true,
  "description": "Desktop control center for ChatGPT Jev (Jev-hardened fork of Codex ChatGPT Web)",
  "author": "miuuyy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.cjs",
    "audit": "bun audit",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "bun run typecheck && bun run build:renderer",
    "build:runtime": "bun run scripts/prepare-runtime.cjs",
    "package": "bun run build && bun run build:runtime && bun run scripts/package.cjs",
    "package:win": "bun run build && bun run build:runtime && bun run scripts/package.cjs --win",
    "smoke:package": "bun run scripts/smoke-package.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.10.7",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.6"
  },
  "build": {
    "appId": "dev.chatgptjev.launcher",
    "productName": "ChatGPT Jev",
    "artifactName": "chatgpt-jev-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "guid": "a10be615-f3b8-4a54-9f50-2c5fd912e945",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
